# Frontend configuration — copy to .env and fill in.
#
#   cp .env.example .env
#
# Anything starting with EXPO_PUBLIC_ is compiled into the app bundle and can
# be read by anyone who installs it. Never put a secret here — no API keys, no
# passwords. Public addresses and switches only.

# Where the FastAPI backend lives, with no trailing slash.
#
# Without this every request goes nowhere and the app shows "Failed to load"
# on each screen. That is the usual cause when the lists are empty.
#
#   local backend:  http://localhost:8000
#   on a phone:     http://<your-laptop-ip>:8000   (localhost is the phone)
#   deployed:       the URL your host gave you
EXPO_PUBLIC_BACKEND_URL=
