# Backend configuration — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env itself is never committed: it holds the admin password and the JWT
# signing key, and a secret that has been in a git history is a secret that
# has to be rotated. This file carries the names only, so nobody has to guess
# what the server expects.
#
# The five under REQUIRED have no default. The server refuses to start without
# them rather than falling back to something insecure — an app that boots with
# a blank signing key is worse than one that will not boot.

# ---- REQUIRED ----------------------------------------------------------

# Where MongoDB lives, and which database inside it.
MONGO_URL=mongodb://localhost:27017
DB_NAME=

# The admin account. ADMIN_PASSWORD is authoritative: change it here, restart
# the server, and the stored account is updated to match on boot. That is how
# you reset it if you no longer know it.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signs the login tokens. Any long random string; treat it like a password.
# Changing it logs everyone out, which is exactly what you want after a leak.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---- OPTIONAL ----------------------------------------------------------

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=

# Which origins the browser may call the API from. Comma-separated.
CORS_ORIGINS=

# Used to build links back into the app, e.g. after a Stripe checkout.
FRONTEND_URL=

# Set to 1 to stop the importer from running on a timer. Useful locally, so a
# laptop does not crawl 40 commune websites while you are debugging something
# unrelated.
DISABLE_SCHEDULER=

# Payments. The app runs fine without these; only the sponsor flow needs them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Salts the hash of viewer IPs for the view counter, so the stored value cannot
# be reversed into an address. Any long random string, set once and left alone
# — changing it makes every previous view look like a new visitor.
VIEW_IP_SALT=

# Where the OpenStreetMap extract is cached. Defaults to /tmp, which is fine;
# point it somewhere persistent to avoid re-downloading 47 MB after a reboot.
OSM_PBF_CACHE=
